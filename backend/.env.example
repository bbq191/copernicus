# =============================================================================
# LLM 配置
# 支持两种后端（二选一）：
#   A. 本地 Ollama（默认，无需 API Key）
#   B. 云端 DeepSeek（需填写 LLM_API_KEY）
# =============================================================================

# 选项 A：本地 Ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:latest

# 选项 B：云端 DeepSeek（使用时取消注释，注释掉选项 A）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-key

LLM_API_KEY=                                                                 # Ollama 无需填写；DeepSeek 必填
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120                                                              # 单次请求超时（秒），超时后使用原文 fallback
LLM_MAX_RETRIES=2                                                            # LLM 调用失败重试次数（指数退避）
LLM_RETRY_DELAY=2.0                                                          # 首次重试延迟（秒），后续 2x 递增
LLM_MAX_CONCURRENT=3                                                         # 全局 LLM 并发上限

# Ollama 上下文窗口（仅 Ollama 后端生效）
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_CTX_CORRECTION=16384
OLLAMA_KEEP_ALIVE=0                                                          # 推理后 LLM 在 VRAM 中的驻留时间（秒）；0=立即释放，防 OOM

# =============================================================================
# VRAM 与模型管理
# =============================================================================
VRAM_BUDGET_GB=16.0                                                          # ModelManager 热插拔阈值（GB），按显卡调整
MEDIA_RETENTION_HOURS=24                                                     # 原始媒体文件保留时长（小时），超期自动清理
MODELS_DIR=./models                                                          # 统一模型目录（funasr/ chattts/ yolo/ 均在此处）
TEMPLATES_DIR=./templates                                                    # 纪要模板目录

# =============================================================================
# ASR 模式: paraformer (说话人分离) | sensevoice (抗噪增强)
# =============================================================================
ASR_MODE=paraformer

# Paraformer 模型配置 (ASR_MODE=paraformer 时使用)
ASR_MODEL_DIR=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
VAD_MODEL_DIR=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
PUNC_MODEL_DIR=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
SPK_MODEL_DIR=iic/speech_campplus_sv_zh-cn_16k-common

# SenseVoice 模型配置 (ASR_MODE=sensevoice 时使用)
SENSEVOICE_MODEL_DIR=iic/SenseVoiceSmall
SENSEVOICE_LANGUAGE=zh                                                       # auto | zh | en | yue | ja | ko
SENSEVOICE_MAX_SEGMENT_MS=15000                                              # 单段最大时长，超过则后处理分割

# 说话人分离配置 (基于声纹相似度聚类)
SPK_SLIDING_WINDOW_MS=1500                                                   # 声纹提取窗口大小（毫秒）
SPK_SLIDING_STEP_MS=750                                                      # 窗口滑动步长（50% 重叠）
SPK_SLIDING_THRESHOLD_MS=3000                                                # 超过此时长启用滑动窗口
SPK_DISTANCE_THRESHOLD=0.5                                                   # 余弦距离阈值（0-1，越小越严格）

# 噪声过滤
FILTER_NOISE_SEGMENTS=true                                                   # 过滤仅含语气词的纯噪声段落

# ASR 通用配置
# 重要：确保安装了 CUDA 版 PyTorch：
# pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
ASR_DEVICE=auto                                                              # auto | cuda | cpu
ASR_BATCH_SIZE=60                                                            # 批次大小；11GB 显存建议 20，16GB 建议 60+
ASR_DTYPE=float16                                                            # float32 | float16 | bfloat16
ASR_DISABLE_PBAR=true                                                        # 关闭推理进度条

# =============================================================================
# 音频增强
# =============================================================================
AUDIO_ENHANCE=true                                                           # ffmpeg loudnorm + 降噪，解决说话人远近不一问题

# =============================================================================
# 文字纠错
# =============================================================================
CORRECTION_CHUNK_SIZE=200                                                    # 每批字符数上限（推荐 150-300）
CORRECTION_OVERLAP=50
CORRECTION_MAX_CONCURRENCY=3                                                 # LLM 并发数
HOTWORD_REPLACER_ENABLED=true                                                # 热词后处理替换（阶段 2）
PYCORRECTOR_ENABLED=true                                                     # pycorrector 轻量级纠错（阶段 3）
PYCORRECTOR_MODEL=macbert                                                    # macbert | kenlm

# =============================================================================
# 置信度过滤
# =============================================================================
CONFIDENCE_THRESHOLD=0.95
CONFIDENCE_RUN_MERGE_GAP=3

# =============================================================================
# 片段预合并
# =============================================================================
PRE_MERGE_GAP_MS=1000

# =============================================================================
# 评估（Map-Reduce 分段摘要）
# =============================================================================
EVALUATION_MAX_TEXT_CHARS=50000                                              # 总上限，超过则截断
EVALUATION_CHUNK_SIZE=6000                                                   # Map 分段大小，短于此直接评估
EVALUATION_NUM_CTX=8192                                                      # 评估专用 num_ctx，控制显存

# =============================================================================
# 合规审核（Map-Reduce）
# =============================================================================
COMPLIANCE_MAX_TEXT_CHARS=50000
COMPLIANCE_CHUNK_SIZE=4000
COMPLIANCE_NUM_CTX=8192
COMPLIANCE_CONFIDENCE_THRESHOLD=0.7                                          # 低于此值的违规被丢弃
COMPLIANCE_DEDUP_WINDOW_MS=30000                                             # 同规则去重时间窗口（毫秒）
COMPLIANCE_GROUP_BY_SOURCE=true                                              # 按证据来源分组审核（transcript/ocr/mixed）
COMPLIANCE_OCR_MARGIN_MS=5000                                                # OCR 时间对齐容差（毫秒）

# =============================================================================
# 热词（可选）
# =============================================================================
HOTWORDS_FILE=

# =============================================================================
# 任务执行
# =============================================================================
TASK_TIMEOUT_SECONDS=3600                                                    # 单任务超时（秒），防止 ASR/LLM 卡住
TASK_MAX_IN_MEMORY=500                                                       # 内存中最大任务数

# =============================================================================
# 上传存储
# =============================================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500                                                       # 直接上传上限；大文件走分片上传（>20MB 自动切换）

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# 视频处理
# =============================================================================
VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.flv,.wmv

# 关键帧提取
KEYFRAME_STRATEGY=interval                                                   # interval | scene
KEYFRAME_INTERVAL_S=2.0                                                      # interval 模式：每 N 秒提取一帧
KEYFRAME_SCENE_THRESHOLD=0.3                                                 # scene 模式：场景变化检测阈值
KEYFRAME_MAX_COUNT=500
KEYFRAME_FORMAT=jpg
KEYFRAME_QUALITY=85

# =============================================================================
# OCR（RapidOCR）
# =============================================================================
OCR_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MIN_TEXT_LENGTH=2

# =============================================================================
# 人脸检测（YOLO）
# 模型路径为计算属性，固定为 models/yolo/yolov8n-face.pt，无需配置
# =============================================================================
FACE_DETECT_ENABLED=true
FACE_DETECT_CONFIDENCE=0.5
FACE_MISSING_THRESHOLD_MS=10000                                              # 人脸缺失超过此时长报告事件

# =============================================================================
# TTS 音频重塑（Phase 4 — ChatTTS）
# 模型目录固定为 models/chattts/，无需配置路径
# =============================================================================
TTS_VRAM_ESTIMATE_GB=4.0                                                     # ChatTTS 显存估算（GB），供 ModelManager 调度
TTS_DEFAULT_VOICES=["2222","3333","4444","5555"]                             # 音色 seed 池，说话人循环匹配
TTS_PAUSE_SWITCH_SPEAKER_MS=800                                              # 换说话人间隔（毫秒）
TTS_SYNTHESIS_BATCH_CHARS=1000                                               # 每批合成字符数，批间清空 VRAM 缓存
TTS_MAX_SENTENCE_CHARS=40                                                    # 单次推理最大字符数，防 OOM 和幻读

# 语音风格参数（0-9 刻度）
TTS_ORAL_LEVEL=2                                                             # 口语化程度（0=播音腔，9=口语）
TTS_BREAK_LEVEL=4                                                            # 停顿换气频率
TTS_LAUGH_LEVEL=0                                                            # 笑声频率（0=禁用）
TTS_ENERGY_LEVEL=5                                                           # 激情程度（0-9：5=自然口语）

# ChatTTS 推理参数
TTS_TEMPERATURE=0.1                                                          # 核心防幻读参数，勿调高于 0.3
TTS_TOP_P=0.7
TTS_TOP_K=20
TTS_MAX_NEW_TOKEN=2048                                                       # 单次推理最大 audio token 数

# LLM 口语改写（合成前将逐字转写重构为自然短句）
TTS_REWRITE_ENABLED=false                                                    # 开启增加约 5-15s 延迟
TTS_REWRITE_BASE_URL=http://localhost:11434                                  # 固定使用本地 Ollama，与主 LLM 后端无关
TTS_REWRITE_MODEL=qwen3:latest
TTS_REWRITE_NUM_CTX=1024                                                     # 改写专用 num_ctx（输入短，无需大窗口）

# =============================================================================
# 日志
# =============================================================================
LOG_TO_FILE=false                                                            # true=写文件（开发环境）；false=stdout（生产/journald）

# =============================================================================
# HuggingFace 离线模式（模型下载完成后启用，避免每次启动联网检查）
# =============================================================================
# HF_HUB_OFFLINE=1
