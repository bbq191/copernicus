# =============================================================================
# LLM 配置（生产环境：本地 Ollama + RTX 2080 Ti 11GB）
# =============================================================================
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen3:latest
LLM_API_KEY=                                                                 # Ollama 无需填写
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180                                                              # 增加超时以减少 ReadTimeout
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=2.0
LLM_MAX_CONCURRENT=3

# 关键：降低 num_ctx 适配 11GB 显存
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_CTX_CORRECTION=4096
OLLAMA_KEEP_ALIVE=0                                                          # 推理后立即释放 LLM 显存，防 ASR+LLM 同时驻留 OOM

# =============================================================================
# VRAM 与模型管理
# =============================================================================
VRAM_BUDGET_GB=12.0                                                          # RTX 2080 Ti 11GB，留 1GB 给系统+CUDA context
MEDIA_RETENTION_HOURS=24                                                     # 原始媒体文件保留时长
MODELS_DIR=./models                                                          # 统一模型目录（funasr/ chattts/ yolo/）
TEMPLATES_DIR=./templates

# =============================================================================
# ASR 模式
# =============================================================================
ASR_MODE=paraformer

# Paraformer 模型配置
ASR_MODEL_DIR=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
VAD_MODEL_DIR=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
PUNC_MODEL_DIR=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
SPK_MODEL_DIR=iic/speech_campplus_sv_zh-cn_16k-common

# SenseVoice 模型配置（ASR_MODE=sensevoice 时使用）
SENSEVOICE_MODEL_DIR=iic/SenseVoiceSmall
SENSEVOICE_LANGUAGE=zh
SENSEVOICE_MAX_SEGMENT_MS=15000

# 说话人分离
SPK_SLIDING_WINDOW_MS=1500
SPK_SLIDING_STEP_MS=750
SPK_SLIDING_THRESHOLD_MS=3000
SPK_DISTANCE_THRESHOLD=0.7                                                   # 0.7 比默认 0.5 更宽松，适合会议场景

# 噪声过滤
FILTER_NOISE_SEGMENTS=true

# ASR 通用配置
ASR_DEVICE=auto
ASR_BATCH_SIZE=20                                                            # 11GB 显存保守值
ASR_DTYPE=float16
ASR_DISABLE_PBAR=true

# =============================================================================
# 音频增强
# =============================================================================
AUDIO_ENHANCE=true

# =============================================================================
# 文字纠错
# =============================================================================
CORRECTION_CHUNK_SIZE=300                                                    # 减小批次，降低单次 LLM 推理超时风险
CORRECTION_OVERLAP=50
CORRECTION_MAX_CONCURRENCY=3
HOTWORD_REPLACER_ENABLED=true
PYCORRECTOR_ENABLED=true
PYCORRECTOR_MODEL=macbert

# =============================================================================
# 置信度过滤 / 片段预合并
# =============================================================================
CONFIDENCE_THRESHOLD=0.95
CONFIDENCE_RUN_MERGE_GAP=3
PRE_MERGE_GAP_MS=1000

# =============================================================================
# 评估（Map-Reduce）
# =============================================================================
EVALUATION_MAX_TEXT_CHARS=50000
EVALUATION_CHUNK_SIZE=6000
EVALUATION_NUM_CTX=8192

# =============================================================================
# 合规审核（Map-Reduce）
# =============================================================================
COMPLIANCE_MAX_TEXT_CHARS=50000
COMPLIANCE_CHUNK_SIZE=4000
COMPLIANCE_NUM_CTX=8192
COMPLIANCE_CONFIDENCE_THRESHOLD=0.7
COMPLIANCE_DEDUP_WINDOW_MS=30000
COMPLIANCE_GROUP_BY_SOURCE=true
COMPLIANCE_OCR_MARGIN_MS=5000

# =============================================================================
# 热词
# =============================================================================
HOTWORDS_FILE=./hotwords.txt

# =============================================================================
# 任务执行
# =============================================================================
TASK_TIMEOUT_SECONDS=3600
TASK_MAX_IN_MEMORY=500

# =============================================================================
# 上传存储（生产使用绝对路径）
# =============================================================================
UPLOAD_DIR=/data/copernicus/uploads
MAX_UPLOAD_SIZE_MB=15000

# =============================================================================
# CORS（Nginx 统一入口，同源无跨域）
# =============================================================================
CORS_ORIGINS=["http://130.100.100.167"]

# =============================================================================
# 视频处理
# =============================================================================
VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.flv,.wmv

KEYFRAME_STRATEGY=interval
KEYFRAME_INTERVAL_S=2.0
KEYFRAME_SCENE_THRESHOLD=0.3
KEYFRAME_MAX_COUNT=500
KEYFRAME_FORMAT=jpg
KEYFRAME_QUALITY=85

# =============================================================================
# OCR（RapidOCR）
# =============================================================================
OCR_ENABLED=true
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MIN_TEXT_LENGTH=2

# =============================================================================
# 人脸检测（YOLO）
# 模型路径为计算属性，固定为 models/yolo/yolov8n-face.pt，无需配置
# =============================================================================
FACE_DETECT_ENABLED=true
FACE_DETECT_CONFIDENCE=0.5
FACE_MISSING_THRESHOLD_MS=10000

# =============================================================================
# TTS 音频重塑（Phase 4 — ChatTTS）
# 11GB 显存：关闭 LLM 改写，TTS 通过 ModelManager 与 ASR 互斥调度
# 模型目录固定为 models/chattts/，无需配置路径
# =============================================================================
TTS_VRAM_ESTIMATE_GB=4.0
TTS_DEFAULT_VOICES=["2222","3333","4444","5555"]
TTS_PAUSE_SWITCH_SPEAKER_MS=800
TTS_SYNTHESIS_BATCH_CHARS=1000
TTS_MAX_SENTENCE_CHARS=40                                                    # RTX 2080 Ti 保守值，防 OOM 和幻读

TTS_ORAL_LEVEL=2                                                             # 会议纪要：轻度口语化
TTS_BREAK_LEVEL=4
TTS_LAUGH_LEVEL=0
TTS_ENERGY_LEVEL=5                                                           # 自然口语风格

TTS_TEMPERATURE=0.1
TTS_TOP_P=0.7
TTS_TOP_K=20
TTS_MAX_NEW_TOKEN=2048

TTS_REWRITE_ENABLED=false                                                    # 关闭 LLM 改写，节省 11GB 显存
TTS_REWRITE_BASE_URL=http://localhost:11434
TTS_REWRITE_MODEL=qwen3:latest
TTS_REWRITE_NUM_CTX=1024

# =============================================================================
# 日志（生产：stdout 由 journald 接管）
# =============================================================================
LOG_TO_FILE=false
