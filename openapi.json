    "/api/v1/evaluate/transcript/async": {
      "post": {
        "tags": ["evaluation"],
        "summary": "Submit Transcript Evaluation Task",
        "description": "接收第三方转写结果，提取正文后生成带评分的50字摘要。\n\n直接接受原始请求体（text/plain），第三方无需对内容做任何转义。\n支持两种格式：\n- 第三方格式：`[时间戳]{JSON}`，自动提取 JSON 中的 content 字段\n- 纯文本：直接作为转写内容处理",
        "operationId": "submit_transcript_evaluation_task_api_v1_evaluate_transcript_async_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskSubmitResponse"
                }
              }
            }
          }
        }
      }
    },
