    "/api/v1/uploads/{file_hash}": {
      "get": {
        "tags": ["uploads"],
        "summary": "Query Upload",
        "description": "查询上传状态；若会话不存在则自动创建（幂等）。\n\n- 文件已处理完成：返回 complete=True + task_id\n- 会话已有部分数据：返回当前 offset（断点续传）\n- 全新文件：创建会话并返回 offset=0",
        "operationId": "query_upload_api_v1_uploads__file_hash__get",
        "parameters": [
          {
            "name": "file_hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Hash"
            }
          },
          {
            "name": "filename",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          },
          {
            "name": "total_size",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Total Size"
            }
          },
          {
            "name": "hotwords",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hotwords"
            }
          },
          {
            "name": "visual_scan",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Visual Scan"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["uploads"],
        "summary": "Upload Chunk",
        "description": "接收数据块并追加。最后一块到达后校验 SHA-256，通过则自动创建转写任务。\n\n请求头：Content-Range: bytes {start}-{end}/{total}\n请求体：raw binary（application/octet-stream）",
        "operationId": "upload_chunk_api_v1_uploads__file_hash__patch",
        "parameters": [
          {
            "name": "file_hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Hash"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadChunkResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
